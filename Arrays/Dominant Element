#include <bits/stdc++.h>
using namespace std;

int main() {

    int T;
    cin >> T;

    while(T--) {

        int N;
        cin >> N;

        vector<int> A(N);

        unordered_map<int,int> freq;

        for(int i = 0; i < N; i++) {
            cin >> A[i];
            freq[A[i]]++;
        }


        int maxFreq = 0;
        int countMax = 0;


        for(auto it : freq) {

            if(it.second > maxFreq) {

                maxFreq = it.second;
                countMax = 1;

            }
            else if(it.second == maxFreq) {

                countMax++;
            }
        }


        if(countMax == 1)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
