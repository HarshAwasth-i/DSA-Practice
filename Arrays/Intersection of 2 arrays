class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        unordered_set<int> s(nums1.begin(), nums1.end());     //duplicate dissappears
        vector<int> ans;

        for (int x : nums2) {            //traverse nums 2
            if (s.count(x)) {          //if it exists
                ans.push_back(x);          //add that
                s.erase(x);        //remove prev
            }
        }
        return ans;
    }
};
