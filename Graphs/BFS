void bfs(int start, vector<vector<int>>& adj) {

    vector<int> vis(adj.size(), 0);
    queue<int> q;

    q.push(start);
    vis[start] = 1;

    while (!q.empty()) {

        int node = q.front();
        q.pop();

        for (int neighbor : adj[node]) {

            if (!vis[neighbor]) {
                vis[neighbor] = 1;
                q.push(neighbor);
            }
        }
    }
}
