class Solution {
public:
    vector<int> topoSort(int V, vector<vector<int>>& adj) {
        vector<int> indegree(V, 0);

        // Calculate indegree of every node
        for (int i = 0; i < V; i++) {
            for (int nei : adj[i]) {
                indegree[nei]++;
            }
        }

        queue<int> q;

        // Push nodes with indegree 0
        for (int i = 0; i < V; i++) {
            if (indegree[i] == 0)
                q.push(i);
        }

        vector<int> topo;

        // Perform BFS
        while (!q.empty()) {
            int node = q.front();
            q.pop();

            topo.push_back(node);

            for (int nei : adj[node]) {
                indegree[nei]--;

                if (indegree[nei] == 0)
                    q.push(nei);
            }
        }

        return topo;
    }
};
