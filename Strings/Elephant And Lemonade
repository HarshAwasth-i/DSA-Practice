#include <bits/stdc++.h>
using namespace std;

int main() {

    int T;
    cin >> T;

    while(T--) {

        int n, m;
        cin >> n >> m;


        vector<int> P(m);

        for(int i = 0; i < m; i++) {
            cin >> P[i];
        }


        vector<int> C(n);

        for(int i = 0; i < n; i++) {
            cin >> C[i];
        }


        vector<bool> visited(n, false);

        long long ans = 0;


        for(int i = 0; i < m; i++) {

            int room = P[i];

            if(!visited[room]) {

                ans += C[room];

                visited[room] = true;
            }
        }


        cout << ans << endl;
    }

    return 0;
}
