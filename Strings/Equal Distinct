#include <bits/stdc++.h>
using namespace std;

int main() {

    int T;
    cin >> T;

    while(T--) {
        int N;
        cin >> N;

        unordered_map<int,int> freq;

        for(int i = 0; i < N; i++) {
            int x;
            cin >> x;

            freq[x]++;
        }

        int distinct = freq.size();

        bool possible = false;

        if(distinct % 2 == 0) {
            possible = true;
        }
        else {
            possible = true;
            for(auto it : freq) {
                if(it.second == 1) {
                    possible = false;
                    break;
                }
            }
        }

        if(possible)
            cout << "YES\n";
        else
            cout << "NO\n";
    }
    return 0;
}
