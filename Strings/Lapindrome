#include <bits/stdc++.h>
using namespace std;

int main() {

    int T;
    cin >> T;

    while(T--) {
        string s;
        cin >> s;

        vector<int> left(26,0);
        vector<int> right(26,0);

        int n = s.length();

        for(int i = 0; i < n/2; i++) {
            left[s[i]-'a']++;
        }

        for(int i = (n+1)/2; i < n; i++) {
            right[s[i]-'a']++;
        }


        if(left == right)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
