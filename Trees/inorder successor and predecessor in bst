class Solution {
public:
    vector<int> succPredBST(TreeNode* root, int key) {
        int pred = -1;
        int succ = -1;

        TreeNode* curr = root;

        while (curr) {

            if (curr->data < key) {
                // Current node can be predecessor
                pred = curr->data;
                curr = curr->right;
            }
            else if (curr->data > key) {
                // Current node can be successor
                succ = curr->data;
                curr = curr->left;
            }
            else {
                // Found the key

                // Predecessor = maximum in left subtree
                TreeNode* temp = curr->left;
                while (temp) {
                    pred = temp->data;
                    temp = temp->right;
                }

                // Successor = minimum in right subtree
                temp = curr->right;
                while (temp) {
                    succ = temp->data;
                    temp = temp->left;
                }

                break;
            }
        }

        return {pred, succ};
    }
};
